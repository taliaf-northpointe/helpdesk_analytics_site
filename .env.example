# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/northpointe_helpdesk"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Azure AD / Entra ID SSO ──────────────────────────────────────────────────
AZURE_AD_CLIENT_ID="your-azure-app-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-app-client-secret"
AZURE_AD_TENANT_ID="your-azure-tenant-id"

# ─── ServiceDesk Plus (SDP On-Demand / Cloud) ─────────────────────────────────
# Base URL of your SDP instance
SDP_BASE_URL="https://northpointe.sdpondemand.manageengine.com"
# Portal name (SDP Cloud only – the subdomain segment)
SDP_PORTAL_NAME="northpointe"
# Zoho OAuth2 credentials (from https://api-console.zoho.com)
SDP_ZOHO_CLIENT_ID="1000.XXXX"
SDP_ZOHO_CLIENT_SECRET="your-client-secret"
SDP_ZOHO_REFRESH_TOKEN="1000.XXXX"
# Sync interval in minutes
SDP_SYNC_INTERVAL_MINUTES="15"
# Client-side deep links to the SDP web UI (used for "Open in ServiceDesk Plus").
# Defaults to the values below if unset. Portal is the /app/<portal>/ segment of the ticket URL.
NEXT_PUBLIC_SDP_BASE_URL="https://northpointe.sdpondemand.manageengine.com"
NEXT_PUBLIC_SDP_PORTAL_NAME="itdesk"

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-api03-..."
# Model to use for the chatbot (default: claude-sonnet-4-6)
CLAUDE_MODEL="claude-sonnet-4-6"

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV="development"
# Comma-separated list of admin email addresses
ADMIN_EMAILS="talia.frazier@northpointe.com"
