generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  role          String        @default("VIEWER")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  sessions      Session[]
  chatSessions  ChatSession[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Ticket domain
// ---------------------------------------------------------------------------

model Ticket {
  id              String   @id @default(cuid())
  externalId      String   @unique
  subject         String
  description     String?
  status          String
  priority        String
  createdAt       DateTime
  updatedAt       DateTime
  resolvedAt      DateTime?
  closedAt        DateTime?
  dueDate         DateTime?
  firstResponseAt DateTime?

  slaId       String?
  sla         SLA?        @relation(fields: [slaId], references: [id])
  slaBreach   Boolean     @default(false)
  slaBreachAt DateTime?

  groupId       String?
  group         Group?      @relation(fields: [groupId], references: [id])
  technicianId  String?
  technician    Technician? @relation(fields: [technicianId], references: [id])
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  resolutionTimeMinutes    Int?
  firstResponseTimeMinutes Int?
  ageingDays               Int?

  rawData String?

  history   TicketHistory[]
  syncJobId String?
  syncJob   SyncJob? @relation(fields: [syncJobId], references: [id])

  createdDay   Int
  createdMonth Int
  createdYear  Int

  @@index([status])
  @@index([groupId])
  @@index([technicianId])
  @@index([categoryId])
  @@index([createdYear, createdMonth])
  @@index([slaBreach])
  @@map("tickets")
}

model TicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())
  changedBy String?

  @@index([ticketId])
  @@map("ticket_history")
}

// ---------------------------------------------------------------------------
// Lookup tables synced from SDP
// ---------------------------------------------------------------------------

model Group {
  id          String            @id @default(cuid())
  externalId  String            @unique
  name        String
  description String?
  isActive    Boolean           @default(true)
  tickets     Ticket[]
  technicians TechnicianGroup[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("groups")
}

model Technician {
  id         String            @id @default(cuid())
  externalId String            @unique
  name       String
  email      String?
  isActive   Boolean           @default(true)
  tickets    Ticket[]
  groups     TechnicianGroup[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("technicians")
}

model TechnicianGroup {
  technicianId String
  groupId      String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([technicianId, groupId])
  @@map("technician_groups")
}

model Category {
  id            String        @id @default(cuid())
  externalId    String        @unique
  name          String
  isActive      Boolean       @default(true)
  tickets       Ticket[]
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("categories")
}

model Subcategory {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  isActive   Boolean  @default(true)
  tickets    Ticket[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("subcategories")
}

model SLA {
  id             String   @id @default(cuid())
  externalId     String   @unique
  name           String
  responseTime   Int
  resolutionTime Int
  isActive       Boolean  @default(true)
  tickets        Ticket[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("slas")
}

// ---------------------------------------------------------------------------
// Analytics cache
// ---------------------------------------------------------------------------

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  period    String
  date      DateTime
  data      String
  createdAt DateTime @default(now())

  @@unique([period, date])
  @@index([period, date])
  @@map("analytics_snapshots")
}

// ---------------------------------------------------------------------------
// Sync jobs
// ---------------------------------------------------------------------------

model SyncJob {
  id           String    @id @default(cuid())
  type         String
  status       String    @default("PENDING")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  ticketCount  Int?
  errorMessage String?
  tickets      Ticket[]

  @@map("sync_jobs")
}

// ---------------------------------------------------------------------------
// Chatbot
// ---------------------------------------------------------------------------

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------------
// Admin configuration
// ---------------------------------------------------------------------------

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_config")
}
