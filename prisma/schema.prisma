generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth / Users
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  chatSessions  ChatSession[]

  @@map("users")
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
}

// ─────────────────────────────────────────────────────────────────────────────
// Ticket domain
// ─────────────────────────────────────────────────────────────────────────────

model Ticket {
  id              String        @id @default(cuid())
  externalId      String        @unique  // SDP request ID
  subject         String
  description     String?       @db.Text
  status          TicketStatus
  priority        TicketPriority
  createdAt       DateTime
  updatedAt       DateTime
  resolvedAt      DateTime?
  closedAt        DateTime?
  dueDate         DateTime?
  firstResponseAt DateTime?

  // SLA
  slaId           String?
  sla             SLA?          @relation(fields: [slaId], references: [id])
  slaBreach       Boolean       @default(false)
  slaBreachAt     DateTime?

  // Relationships
  groupId         String?
  group           Group?        @relation(fields: [groupId], references: [id])
  technicianId    String?
  technician      Technician?   @relation(fields: [technicianId], references: [id])
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     Subcategory?  @relation(fields: [subcategoryId], references: [id])

  // Metrics
  resolutionTimeMinutes Int?
  firstResponseTimeMinutes Int?
  ageingDays      Int?          // computed at sync time

  // Raw data snapshot from SDP
  rawData         Json?

  history         TicketHistory[]
  syncJobId       String?
  syncJob         SyncJob?      @relation(fields: [syncJobId], references: [id])

  createdDay      Int           // day-of-month for fast aggregation
  createdMonth    Int           // 1-12
  createdYear     Int

  @@index([status])
  @@index([groupId])
  @@index([technicianId])
  @@index([categoryId])
  @@index([createdYear, createdMonth])
  @@index([slaBreach])
  @@map("tickets")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())
  changedBy String?

  @@index([ticketId])
  @@map("ticket_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lookup tables synced from SDP
// ─────────────────────────────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  externalId  String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  tickets     Ticket[]
  technicians TechnicianGroup[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("groups")
}

model Technician {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  email      String?
  isActive   Boolean  @default(true)
  tickets    Ticket[]
  groups     TechnicianGroup[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("technicians")
}

model TechnicianGroup {
  technicianId String
  groupId      String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([technicianId, groupId])
  @@map("technician_groups")
}

model Category {
  id           String        @id @default(cuid())
  externalId   String        @unique
  name         String
  isActive     Boolean       @default(true)
  tickets      Ticket[]
  subcategories Subcategory[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("categories")
}

model Subcategory {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  isActive   Boolean  @default(true)
  tickets    Ticket[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("subcategories")
}

model SLA {
  id           String   @id @default(cuid())
  externalId   String   @unique
  name         String
  responseTime Int      // minutes
  resolutionTime Int    // minutes
  isActive     Boolean  @default(true)
  tickets      Ticket[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("slas")
}

// ─────────────────────────────────────────────────────────────────────────────
// Analytics cache (pre-aggregated for fast dashboard queries)
// ─────────────────────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id        String   @id @default(cuid())
  period    String   // "daily" | "weekly" | "monthly" | "quarterly" | "yearly"
  date      DateTime // start of period
  data      Json     // aggregated KPI blob
  createdAt DateTime @default(now())

  @@unique([period, date])
  @@index([period, date])
  @@map("analytics_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sync jobs
// ─────────────────────────────────────────────────────────────────────────────

model SyncJob {
  id          String     @id @default(cuid())
  type        SyncType
  status      SyncStatus @default(PENDING)
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  ticketCount Int?
  errorMessage String?   @db.Text
  tickets     Ticket[]

  @@map("sync_jobs")
}

enum SyncType {
  FULL
  INCREMENTAL
  MANUAL
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// Chatbot
// ─────────────────────────────────────────────────────────────────────────────

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin configuration
// ─────────────────────────────────────────────────────────────────────────────

model AppConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_config")
}
